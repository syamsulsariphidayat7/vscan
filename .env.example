[TEMPLATE]
# --- VScan . Env Template (copy ke .env.local) ---
# Base URL API apotek — dipakai ROUTE SERVER VScan (/api/check & /api/push),
# browser tidak pernah memanggil apotek langsung.
# Dev: http://localhost:3000 (apotek) · Produksi: https://apotek.boundless.my.id
APOTEK_API_URL="https://apotek.boundless.my.id"

# (Opsional) fallback lama bila APOTEK_API_URL tidak diset — tidak wajib.
# NEXT_PUBLIC_APOTEK_API_URL="https://apotek.boundless.my.id"
