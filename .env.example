[TEMPLATE]
# --- VScan mandiri . Template Env (copy ke .env) ---
# VScan punya database sendiri (Neon Postgres di produksi / Vercel).
# Lokal: postgresql://postgres@localhost:5432/vscan
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vscan?sslmode=require"

# Matikan telemetri Next.js (opsional)
NEXT_TELEMETRY_DISABLED="1"
