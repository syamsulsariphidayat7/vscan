# VScan Scanner Agent — konfigurasi
# Salin file ini menjadi `agent.env` lalu isi kode pairing milikmu.
# Agent otomatis membaca agent.env setiap kali dijalankan (tanpa perlu
# mengetik argumen lagi). Argumen --code tetap bisa mengalahkan nilai ini.

# Kode pairing dari halaman VScan (tombol "Daftarkan Proyek / POS").
# Berlaku 12 jam; buat kode baru bila kedaluwarsa.
VSCAN_CODE=

# Server VScan (biarkan default bila pakai produksi).
VSCAN_URL=https://vscan.boundless.my.id

# Interval polling dalam detik (default 1).
VSCAN_INTERVAL=1
