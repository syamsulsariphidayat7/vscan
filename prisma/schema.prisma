// VScan — layanan pairing barcode mandiri.
//
// VScan punya database sendiri (Neon Postgres di produksi). HP (client) hanya
// mengirim barcode dengan kode pairing; proyek mana pun (POS apotek, dll.)
// "mendaftarkan URL" dan menerima hasil scan — tanpa perlu mengubah kode
// proyek untuk urusan pairing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Satu "saluran" pairing: proyek mendaftar (label + URL tujuan) → mendapat
/// kode 6 karakter yang diketik HP. Berlaku 12 jam.
model ScanSession {
  id           String        @id @default(cuid())
  code         String        @unique
  /// Pemilik sesi (cookie browser pembuat) — untuk daftar sesi milik sendiri.
  ownerId      String?
  /// Nama proyek / kasir / POS (mis. "Kasir 1 - Apotek Sehat")
  label        String
  /// URL tujuan — VScan mengirim barcode ke sini (webhook). Opsional; tanpa
  /// ini proyek bisa mengambil via GET /api/poll.
  webhookUrl   String?
  /// Secret bersama untuk verifikasi di sisi proyek (opsional).
  webhookToken String?
  status       String        @default("active") // active | closed
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  pendingScans PendingScan[]

  @@index([code])
  @@index([status])
  @@index([ownerId, status])
}

/// Antrean barcode hasil scan HP untuk satu sesi.
model PendingScan {
  id          String      @id @default(cuid())
  sessionId   String
  session     ScanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  barcode     String
  status      String      @default("pending") // pending | delivered | failed | polled
  attempts    Int         @default(0)
  lastError   String?
  createdAt   DateTime    @default(now())
  deliveredAt DateTime?

  @@index([sessionId, status])
  @@index([createdAt])
}
