[Unit]
Description=VScan Scanner Server (Next.js production)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/http/vscan
EnvironmentFile=%h/.config/vscan/env
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/pnpm exec next start -p 3000 -H 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
